# Verify the aarch64-unknown-linux-musl N-API build in a native ARM64 Alpine environment.
FROM rust:1.88.0-alpine

WORKDIR /workspace

# The N-API CLI defaults to an aarch64 cross-linker for this target. On a
# native ARM64 Alpine builder, use Alpine's host C compiler instead.
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_LINKER=gcc

RUN apk add --no-cache build-base musl-dev nodejs npm openssl-dev \
    && npm install --global corepack \
    && corepack enable \
    && corepack prepare yarn@4.9.2 --activate

COPY package.json yarn.lock ./
RUN yarn install --immutable

COPY . .

RUN yarn build --target aarch64-unknown-linux-musl \
    && test -s mdpdf.linux-arm64-musl.node

# Build with Docker Buildx/QEMU when the host is not ARM64:
# docker build --platform linux/arm64 -f Dockerfile.musl .
